{
  "manifest_version": 3,
  "name": "Tabkeeper",
  "version": "1.1.0",
  "description": "Close tabs by rule, organise tab groups with live page status, and group AWS Console tabs by account and role.",
  "minimum_chrome_version": "121",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "options/options.html?popup=1",
    "default_title": "Tabkeeper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause or resume closing"
    },
    "group-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Apply grouping rules to the current tab"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
